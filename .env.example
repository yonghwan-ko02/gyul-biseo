# 환경 변수 설정 템플릿
# 이 파일을 .env로 복사하여 실제 값을 채우세요.
# .env 파일은 절대 git에 커밋하지 마세요!

# ─────────────────────────────────────────
# 앱 기본 설정
# ─────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
SECRET_KEY=your-secret-key-here  # 32자 이상 랜덤 문자열
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ─────────────────────────────────────────
# OpenAI (LLM)
# ─────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o              # gpt-4o | gpt-4o-mini

# ─────────────────────────────────────────
# 카카오 i Open Builder
# ─────────────────────────────────────────
KAKAO_REST_API_KEY=...           # 카카오 REST API 키
KAKAO_CHANNEL_SECRET=...         # 채널 시크릿 (웹훅 서명 검증용)
KAKAO_BOT_ID=...                 # 챗봇 ID
KAKAO_SEND_FROM_KAKAO_ID=...     # 정산서 발송용 카카오 ID

# ─────────────────────────────────────────
# Naver Clova (STT + OCR)
# ─────────────────────────────────────────
NAVER_CLIENT_ID=...              # Clova Speech & OCR 클라이언트 ID
NAVER_CLIENT_SECRET=...          # 클라이언트 시크릿
NAVER_STT_URL=https://naveropenapi.apigw.ntruss.com/recog/v1/stt
NAVER_OCR_URL=https://...        # Clova OCR API URL
NAVER_OCR_SECRET=...             # OCR Secret

# ─────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gyul_biseo
POSTGRES_USER=gyul_user
POSTGRES_PASSWORD=your-db-password
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ─────────────────────────────────────────
# ChromaDB (Vector Store)
# ─────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ─────────────────────────────────────────
# 농장 기본 정보 (초기 설정용)
# ─────────────────────────────────────────
FARMER_BANK_NAME=농협              # 정산서 계좌 은행명
FARMER_BANK_ACCOUNT=xxx-xxxx-xxxx-xx  # 계좌번호
FARMER_BANK_HOLDER=홍길동           # 예금주
